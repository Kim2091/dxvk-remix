#pragma once

#include "rtx/utility/common.slangh"
#include "rtx/utility/packing.slangh"
#include "rtx/utility/math.slangh"
#include "rtx/concept/ray/ray.slangh"
#include "rtx/algorithm/resolve.h"
#include "rtx/algorithm/resolve_expanded.slangh"
// Brings in RestirPtHit, RestirPtReservoir and RestirPtPathBuilder. The
// dependency runs one way only: reservoir -> builder -> path state.
#include "rtx/algorithm/fork_restir_pt/restir_pt_path_builder.slangh"

// ReSTIR PT (fork) -- live path state for the fork-owned trace kernel.
//
// ports ReSTIRPTPass/PathState.slang:17-39 (PathFlags) and :64-243 (PathState),
// minus:
//   - the packed encode()/decode() pair (:193-241). Our kernel is one compute
//     loop with an inline RayQuery resolve; nothing crosses a ray-payload
//     boundary, so there is nothing to pack.
//   - InteriorList / nested dielectrics (dxvk-remix tracks the medium with a
//     single mediumMaterialIndex, integrator_indirect.slangh:440-463)
//   - the volume/freePath machinery (the reference ignores volume scattering in
//     replay too -- see the plan's Out of scope)
//
// What it adds over the reference: the replay identity pair (srcPixel, srcFrame)
// in place of the reference's captured LCG seeds
// (ReSTIRPTPass/PathReservoir.slang:229,233), and the IBasePayloadState
// implementation dxvk-remix's resolve loop requires (resolve.h:66-83).

// Path flags. Bit values are kept IDENTICAL to
// ReSTIRPTPass/PathState.slang:17-39 so the two can be diffed line by line.
// Bits the reference reserves but this port does not produce (volume 0x0020,
// insideDielectricVolume 0x0040, freePath 0x0400) are left declared-but-unused
// rather than renumbered, so a future phase can light them up without shifting
// anything already stored.
static const uint16_t kRestirPtFlagActive                 = uint16_t(0x0001);  // Path is active (not terminated).
static const uint16_t kRestirPtFlagHit                    = uint16_t(0x0002);  // Result of the scatter ray (0 = miss, 1 = hit).
static const uint16_t kRestirPtFlagTransmission           = uint16_t(0x0004);  // Scatter ray went through a transmission event.
static const uint16_t kRestirPtFlagSpecular               = uint16_t(0x0008);  // Scatter ray went through a specular event.
static const uint16_t kRestirPtFlagDelta                  = uint16_t(0x0010);  // Scatter ray went through a delta event.
static const uint16_t kRestirPtFlagVolume                 = uint16_t(0x0020);  // Unused in this port (no volume scattering in the kernel).
static const uint16_t kRestirPtFlagInsideDielectricVolume = uint16_t(0x0040);  // Unused in this port (medium tracked via mediumMaterialIndex).
static const uint16_t kRestirPtFlagLightSampledUpper      = uint16_t(0x0080);  // Last vertex sampled lights via NEE in the upper hemisphere.
static const uint16_t kRestirPtFlagLightSampledLower      = uint16_t(0x0100);  // Last vertex sampled lights via NEE in the lower hemisphere.
static const uint16_t kRestirPtFlagDiffusePrimaryHit      = uint16_t(0x0200);  // Primary hit sampled from a diffuse lobe (denoiser routing).
static const uint16_t kRestirPtFlagFreePath               = uint16_t(0x0400);  // Unused in this port.
static const uint16_t kRestirPtFlagSpecularBounce         = uint16_t(0x0800);  // Everything that is not diffuse.
static const uint16_t kRestirPtFlagSpecularPrimaryHit     = uint16_t(0x1000);  // Primary hit sampled from a specular lobe (denoiser routing).
// FORK-OWNED, no reference twin. "The lobe just sampled belongs to the SPECULAR
// class", with NO roughness test -- which is what the reference's specularBounce
// means and what the reconnection shift needs to pick the lobe class it restricts
// its evaluations to. Distinct from kRestirPtFlagSpecularBounce, which this fork
// redefined as a denoiser-routing decision. See the long note on
// RestirPtPathFlags::insertIsSpecularLobeClass.
static const uint16_t kRestirPtFlagSpecularLobeClass      = uint16_t(0x2000);

// Bounce type counters, one byte each inside bounceCounters.
// ports ReSTIRPTPass/PathState.slang:43-49.
static const uint kRestirPtBounceTypeDiffuse      = 0u;
static const uint kRestirPtBounceTypeSpecular     = 1u;
static const uint kRestirPtBounceTypeTransmission = 2u;

// Sentinel scene length written on a miss, mirroring the reference's
// kNRDInvalidPathLength usage at ReSTIRPTPass/PathTracer.slang:841.
static const float kRestirPtInvalidPathLength = 65504.0f;

// Note: RestirPtHit moved to restir_pt_reservoir.slangh in phase 2 (the
// reservoir stores one, and the reservoir header must not depend on this file).

// Live state for the ReSTIR PT trace kernel. Doubles as the resolve loop's
// payload, so it must satisfy IBasePayloadState (resolve.h:66-83).
struct RestirPtPathState : IBasePayloadState
{
  // --- Resolve-loop / IBasePayloadState backing storage -------------------
  // Note: kept as full-precision scalars rather than the packed representation
  // the upstream PathState uses (path_state.slangh:55-92). That struct is
  // packed because it has to fit in a ray payload; ours never leaves registers.

  vec3 _origin;
  vec3 _direction;
  float _coneRadius;
  float _segmentHitDistance;
  uint8_t _rayMask;
  PortalSpace2BitsType _portalSpace;
  // continueResolving / decalEncountered / continuePath, plus the medium flag.
  uint8_t _stateFlags;

  // The pixel this invocation writes to. Required by the RESOLVE_* macros'
  // interaction-count debug-view tail (resolve_expanded.slangh:182-186).
  u16vec2 pixelCoordinate;

  // --- Replay identity ----------------------------------------------------
  // Replaces the reference's captured RNG seeds
  // (ReSTIRPTPass/PathReservoir.slang:229 rcRandomSeed, :233 initRandomSeed).
  // Every RNG draw in the kernel is a pure function of these two plus
  // (bounce, site) -- see restir_pt_rng.slangh.
  u16vec2 srcPixel;
  uint srcFrameIdx;

  // --- Reference-diffable path bookkeeping --------------------------------

  uint16_t flags;             // kRestirPtFlag* OR'ed together.  ports :68
  uint16_t length;            // 0 at the primary surface, 1 at the first secondary hit.  ports :69
  uint bounceCounters;        // Packed per-BounceType counters.  ports :72
  float pdf;                  // Pdf that generated the in-flight scatter ray (pdfAll).  ports :77
  vec3 normal;                // Shading normal at the scatter ray origin (needed for MIS).  ports :78
  RestirPtHit hit;            // Hit info for the in-flight scatter ray.  ports :79
  vec3 thp;                   // Path throughput, POSTFIX only from phase 3 on.  ports :81
  // Throughput of the path PREFIX -- everything up to and including the scatter
  // at the reconnection vertex. recordPrefixThp() moves thp into here and resets
  // thp to 1, so `thp` afterwards measures the suffix alone. ports :82
  vec3 prefixThp;
  vec3 L;                     // Accumulated path contribution.  ports :86
  vec3 LDeltaDirect;          // Direct lighting seen through delta/transmission chains.  ports :87
  float russianRoulettePdf;   // Product of survival probabilities.  ports :89
  float prevScatterPdf;       // Single-lobe pdf of the previous scatter.  ports :91
  float sceneLength;          // Path length in scene units, 0 at the primary hit.  ports :71
  float firstSegmentLength;   // Length of the first indirect segment (denoiser feed, phase 2).

  // World position the in-flight scatter ray was LAUNCHED from, i.e. the previous
  // path vertex. Stands in for the reference's `prevPathOrigin`
  // (ReSTIRPTPass/PathTracer.slang:1130), which it can read straight off
  // `path.origin` because Falcor has no resolve loop; here the resolve macro
  // advances `path.origin` through every alpha / portal / decal continuation
  // (resolve_expanded.slangh:176), so the launch point has to be kept separately
  // or the reconnection geometry factor would measure from a foliage leaf rather
  // than from the vertex that scattered. Written once per segment by
  // restirPtTracePathInternal.
  vec3 scatterRayOrigin;

  // --- dxvk-remix specific carry-over -------------------------------------
  float coneSpreadAngle;      // Ray-cone spread, fed into texture LOD by the resolver.
  uint mediumMaterialIndex;   // Translucent medium the path is currently inside, or SURFACE_INDEX_INVALID.
  float accumulatedHitDistance;

  // --- Reservoir construction (phase 2) -----------------------------------
  // ports the PathState members ReSTIRPTPass/PathState.slang carries for the
  // same purpose (`pathBuilder`, `pathReservoir`). The reference keeps them in
  // PathState too; here that costs nothing extra because this port has no ray
  // payload to pack them into -- the state never leaves registers.
  RestirPtPathBuilder pathBuilder;
  RestirPtReservoir pathReservoir;

  // False for the PSR / secondary-selected continuation entry, which produces a
  // plain radiance estimate for IndirectRadianceHitDistance and must not offer
  // its terminals to a reservoir (nothing shades one for those pixels -- see
  // demodulate.comp.slang:776-798 for who consumes them instead).
  bool buildReservoir;

  // NEE-cache cell of the PRIMARY surface, jittered once at path generation.
  // Twin of PathState::neeCacheCellOffset (path_state.slangh:65), set the same
  // way the indirect integrator sets it (integrator_indirect.slangh:1360-1368).
  // Used for the length-1 emissive MIS weight and the emissive task feedback.
  int neeCacheCellOffset;
  bool neeCacheCellValid;

  // --- Replay control -----------------------------------------------------
  // ports ReSTIRPTPass/PathState.slang:104-107. Phase 1 uses these purely for
  // the parity harness (re-trace a path from its identity and compare); the
  // hybrid-shift consumers (isReplayForHybridShift, useHybridShift,
  // isLastVertexClassifiedAsRough) arrive in phase 5.
  bool enableRandomReplay;
  bool randomReplayIsNEE;
  bool randomReplayIsEscaped;
  int randomReplayLength;

  // --- IBasePayloadState implementation -----------------------------------

  property float3 origin
  {
    get { return _origin; }
    set { _origin = newValue; }
  }

  property vec3 direction
  {
    get { return _direction; }
    set { _direction = newValue; }
  }

  property float coneRadius
  {
    get { return _coneRadius; }
    set { _coneRadius = newValue; }
  }

  property float segmentHitDistance
  {
    get { return _segmentHitDistance; }
    set { _segmentHitDistance = newValue; }
  }

  property uint8_t rayMask
  {
    get { return _rayMask; }
    set { _rayMask = newValue; }
  }

  property PortalSpace2BitsType portalSpace
  {
    get { return _portalSpace; }
    set { _portalSpace = newValue; }
  }

  property bool continueResolving
  {
    get { return packedFlagGet(_stateFlags, 1 << 0); }
    set { _stateFlags = packedFlagAssign(_stateFlags, 1 << 0, newValue); }
  }

  property bool decalEncountered
  {
    get { return packedFlagGet(_stateFlags, 1 << 1); }
    set { _stateFlags = packedFlagAssign(_stateFlags, 1 << 1, newValue); }
  }

  // Note: Used as both input and output to indicate whether another scatter ray
  // should be cast. Distinct from the reference's `active` PathFlag, which this
  // port keeps for diffability; continuePath is what the resolve-driven outer
  // loop actually reads.
  property bool continuePath
  {
    get { return packedFlagGet(_stateFlags, 1 << 2); }
    set { _stateFlags = packedFlagAssign(_stateFlags, 1 << 2, newValue); }
  }

  property bool insideMedium
  {
    get { return packedFlagGet(_stateFlags, 1 << 3); }
    set { _stateFlags = packedFlagAssign(_stateFlags, 1 << 3, newValue); }
  }

  // Note: The ReSTIR PT kernel never traverses ray portals (they are classified
  // delta and terminate the path, see the plan's material mapping), so direction
  // alteration and the accumulated portal rotation are both no-ops here. Matches
  // how the upstream indirect PathState stubs them out
  // (path_state.slangh:384-388,425-429).
  property bool directionAltered
  {
    get { return false; }
    set { }
  }

  property vec4 accumulatedRotation
  {
    get { return getIdentityQuaternion(); }
    set { }
  }

  bool shouldReorder(out uint coherenceHints, out uint numCoherenceHints)
  {
    coherenceHints = 0;
    numCoherenceHints = 0;
    return false;
  }

  // --- Flag accessors (ports ReSTIRPTPass/PathState.slang:117-159) ---------

  bool hasFlag(uint16_t flag) { return (flags & flag) != uint16_t(0); }

  [mutating] void setFlag(uint16_t flag, bool value)
  {
    if (value) { flags |= flag; }
    else { flags &= ~flag; }
  }

  bool isActive() { return hasFlag(kRestirPtFlagActive); }
  bool isTerminated() { return !isActive(); }
  bool isHit() { return hasFlag(kRestirPtFlagHit); }
  bool isTransmission() { return hasFlag(kRestirPtFlagTransmission); }
  bool isSpecular() { return hasFlag(kRestirPtFlagSpecular); }
  bool isDelta() { return hasFlag(kRestirPtFlagDelta); }
  bool isSpecularBounce() { return hasFlag(kRestirPtFlagSpecularBounce); }
  // Fork-owned. NOT a synonym for isSpecularBounce -- see kRestirPtFlagSpecularLobeClass.
  bool isSpecularLobeClass() { return hasFlag(kRestirPtFlagSpecularLobeClass); }
  bool isLightSampled() { return (flags & (kRestirPtFlagLightSampledUpper | kRestirPtFlagLightSampledLower)) != uint16_t(0); }
  bool isLightSampledUpper() { return hasFlag(kRestirPtFlagLightSampledUpper); }
  bool isLightSampledLower() { return hasFlag(kRestirPtFlagLightSampledLower); }
  bool isDiffusePrimaryHit() { return hasFlag(kRestirPtFlagDiffusePrimaryHit); }
  bool isSpecularPrimaryHit() { return hasFlag(kRestirPtFlagSpecularPrimaryHit); }

  // A delta scatter event cannot be reproduced by light sampling, so it is not
  // eligible for MIS against NEE.  ports :134
  bool isLightSamplable() { return !isDelta(); }

  [mutating] void terminate() { setFlag(kRestirPtFlagActive, false); continuePath = false; }
  [mutating] void setActive() { setFlag(kRestirPtFlagActive, true); }

  [mutating] void setHit(RestirPtHit hitInfo) { hit = hitInfo; setFlag(kRestirPtFlagHit, true); }
  [mutating] void clearHit() { hit = RestirPtHit::createInvalid(); setFlag(kRestirPtFlagHit, false); }

  // ports :141
  [mutating] void clearEventFlags()
  {
    flags &= ~(kRestirPtFlagTransmission | kRestirPtFlagSpecular | kRestirPtFlagDelta |
               kRestirPtFlagVolume | kRestirPtFlagSpecularBounce | kRestirPtFlagSpecularLobeClass);
  }

  [mutating] void setTransmission(bool value) { setFlag(kRestirPtFlagTransmission, value); }
  [mutating] void setSpecular(bool value) { setFlag(kRestirPtFlagSpecular, value); }
  [mutating] void setDelta(bool value) { setFlag(kRestirPtFlagDelta, value); }
  [mutating] void setSpecularBounce(bool value) { setFlag(kRestirPtFlagSpecularBounce, value); }
  [mutating] void setSpecularLobeClass(bool value) { setFlag(kRestirPtFlagSpecularLobeClass, value); }
  [mutating] void setLightSampled(bool upper, bool lower)
  {
    setFlag(kRestirPtFlagLightSampledUpper, upper);
    setFlag(kRestirPtFlagLightSampledLower, lower);
  }
  [mutating] void setDiffusePrimaryHit(bool value) { setFlag(kRestirPtFlagDiffusePrimaryHit, value); }
  [mutating] void setSpecularPrimaryHit(bool value) { setFlag(kRestirPtFlagSpecularPrimaryHit, value); }

  // --- Bounce counters (ports :161-178) -----------------------------------

  uint getBounces(uint type)
  {
    const uint shift = type << 3;
    return (bounceCounters >> shift) & 0xffu;
  }

  [mutating] void incrementBounces(uint type)
  {
    const uint shift = type << 3;
    // Note: counters are assumed not to overflow -- the path length is capped
    // well below 255 by cb.restirPtMaxBounces.
    bounceCounters += (1u << shift);
  }

  // --- Throughput helpers -------------------------------------------------

  // ports :114. The full path throughput, prefix and suffix recombined. Every
  // radiance ACCUMULATION site uses this, so path.L is unchanged by the split.
  vec3 getCurrentThp() { return thp * prefixThp; }

  // ports :115. Folds the throughput accumulated so far into the prefix and
  // restarts `thp` at 1. Called after every scatter whose vertex index is at or
  // before the reconnection vertex (PathTracer.slang:419-420), so that once the
  // path passes the reconnection vertex, `thp` measures the SUFFIX alone -- which
  // is exactly what the reservoir stores as rcVertexIrradiance and what the shift
  // re-attaches to a different prefix.
  //
  // Phase 2 shipped this as the identity (prefix pinned to 1) because
  // rcVertexLength was pinned at kRestirPtMaximumPathLength; phase 3 sets
  // rcVertexLength = 1 at the first indirect hit, which makes the split real.
  [mutating] void recordPrefixThp()
  {
    prefixThp *= thp;
    thp = vec3(1.0f);
  }
};
