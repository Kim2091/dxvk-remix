#pragma once

#include "rtx/algorithm/fork_restir_pt/restir_pt_rng.slangh"
#include "rtx/algorithm/fork_restir_pt/restir_pt_path_state.slangh"

// ReSTIR PT (fork) -- the trace core.
//
// A port of the reference path-tracing loop
// (ReSTIRPTPass/PathTracer.slang, driven by ReSTIRPTPass/TracePass.cs.slang:19-43)
// onto dxvk-remix concepts, with two deliberate departures:
//
//   1. RNG. Every consuming site re-bases through restirPtRngAt() at a fixed
//      dimension instead of threading one serial generator down the path. See
//      restir_pt_rng.slangh for why this is strictly stronger than the
//      reference's seed capture/restore.
//
//   2. Ray casting. The reference calls SceneRayQuery<kUseAlphaTest>::traceRay
//      (ReSTIRPTPass/PathTracer.slang:822-843). dxvk-remix resolves alpha,
//      decals, portals and unordered geometry in a host-side *resolve loop*
//      driven by the RESOLVE_RAY_QUERY macro (resolve_expanded.slangh:110), so
//      "trace one segment" here means "run the resolve loop with our own hit
//      callback". That callback is restirPtHandleVertex below, and it is the
//      structural twin of integratePathVertex
//      (integrator_indirect.slangh:213) -- but fork-owned, so the live
//      integrator is untouched.
//
// PHASE 1 SCOPE. This is the replay-discipline harness, not the finished
// integrator. Present: primary-surface scatter from the G-buffer, N-bounce
// indirect tracing, emissive accumulation with a MIS stub, plain-RIS NEE with a
// shadow ray, throughput-based Russian roulette, sky/dome/env on miss, and a
// full replay entry point. Absent (later phases, per the plan): reservoirs and
// the PathBuilder RIS stream (phase 2), reconnection-vertex bookkeeping and the
// hybrid shift (phases 3/5), NEE-cache sampling and its MIS pdf (phase 2 open
// question), NRC/PSR side products (phase 2).
//
// REPLAY-SAFETY NOTE on the resolver's out-of-band RNG. resolve.slangh:753
// declares a *static* `resolveVertexUnorderedRng = createRNGAnywhere(cb.frameIdx, 555)`
// that is consumed a data-dependent number of times by decal reservoir sampling
// (resolve.slangh:1453) and by decal bin dithering (:789). Neither is reachable
// from this kernel: :1453 lives inside resolveVertexUnordered<> (which we never
// call, because we never set resolveModeSeparateUnorderedApproximations) and
// :789 is only called under RAY_TRACING_PRIMARY_RAY (which this pass does not
// define). The plan flags this stream as the main residual replay hazard; in
// phase 1 it is contained by construction, and the parity debug view is the
// detector if a later phase turns either path on.

#ifdef ATMOSPHERE_AVAILABLE
#include "rtx/pass/atmosphere/atmosphere_sky.slangh"
#endif

// Clamp used in throughput divisions, mirroring path_state.slangh:43. Redefined
// here rather than including path_state.slangh, which drags in the NRC headers
// and the upstream payload we deliberately do not share.
static const float kRestirPtThroughputClampedDivisionMaximum = 65000.0f;

// Terminal-vertex classification stored alongside the parity radiance so a
// replay can match the base path's termination. `Escaped` is the reference's
// "escape vertex" (the path left the scene); `NeeTerminal` is the reference's
// lastVertexNEE and only becomes reachable in phase 2, when the PathBuilder
// starts selecting NEE vertices as path terminals
// (ReSTIRPTPass/PathBuilder.slang addNeeVertex).
static const uint kRestirPtTerminalNone    = 0u;  // Ended by Russian roulette or the bounce cap.
static const uint kRestirPtTerminalEscaped = 1u;  // Ended on a miss (sky / env).
static const uint kRestirPtTerminalNee     = 2u;  // Reserved for phase 2.

// Extra-args bundle threaded through the resolve macro to the hit callback.
// Empty for phase 1 -- everything the callback needs is either in the payload or
// in a global binding. Kept as a named type (rather than EmptyExtraArgs) so the
// later phases that need to hand the callback a reservoir buffer have a place to
// put it without touching every call site.
struct RestirPtTraceArgs
{
  // Slang zero-init emits an empty initializer list per declaration, which
  // leaves any resource members uninitialized; an explicit empty ctor works
  // around it. Same workaround as IndirectPathTextures, path_state.slangh:545.
  __init() {}
};

// ---------------------------------------------------------------------------
// Leaf helpers
// ---------------------------------------------------------------------------

// Fork-local twin of calculateSpreadAngleFromSolidAnglePdf
// (integrator.slangh:90-121), duplicated for the same include-graph reason as
// the other leaf helpers below. Keep in sync.
float calculateSpreadAngleFromSolidAnglePdfLocal(float incomingSpreadAngle, float solidAnglePdf)
{
  // Note: A pdf of exactly 1 means a dirac was sampled (perfectly smooth opaque
  // or translucent), where the cone math breaks down.
  if (solidAnglePdf == 1.0f)
  {
    return incomingSpreadAngle;
  }

  const float newSpreadAngle =
    2.0f * asin(sqrt(saturate(1.0f / (4.0f * pi * solidAnglePdf)))) * cb.indirectRaySpreadAngleFactor;

  return max(incomingSpreadAngle, newSpreadAngle);
}

// Samples a scatter direction from the material and folds the sample throughput
// in. A fork-local twin of sampleDirection (integrator.slangh:123-166); it is
// duplicated rather than called so this pass does not have to include
// integrator.slangh, which pulls in nee_cache.h and therefore would force the
// whole NEE-cache binding set (NeeCache / NeeCacheTask / NeeCacheSample /
// NeeCacheThreadTask / PrimitiveIDPrefixSum) into a pass that does not use it.
// Keep in sync with integrator.slangh:123 if that function changes.
Ray restirPtSampleScatterDirection(
  inout RNG randomState, inout bool insideMedium, inout vec3 throughput,
  Ray ray, MinimalRayInteraction minimalRayInteraction, MinimalSurfaceInteraction minimalSurfaceInteraction,
  PolymorphicSurfaceMaterialInteraction polymorphicSurfaceMaterialInteraction,
  out uint8_t sampledLobe, out float sampledLobePdf, out float solidAnglePdf)
{
  SurfaceMaterialInteractionSample surfaceMaterialInteractionSample;
  SurfaceMaterialInteractionLobeSample surfaceMaterialInteractionLobeSample;
  bool penetrateSurface = false;

  // Note: consumes exactly 3 samples from randomState -- 1 for the lobe
  // selection (polymorphic_surface_material_interaction.slangh:153) and 2 for
  // the lobe's 2D direction sample. That is precisely the
  // kRestirPtDimLobe / kRestirPtDimDirection reservation, which is why a single
  // RNG created at kRestirPtDimLobe covers both sites.
  polymorphicSurfaceMaterialInteractionCalcSample(
    polymorphicSurfaceMaterialInteraction, randomState, minimalRayInteraction,
    surfaceMaterialInteractionSample, surfaceMaterialInteractionLobeSample,
    insideMedium, penetrateSurface, false);

  sampledLobe = surfaceMaterialInteractionLobeSample.lobe;
  sampledLobePdf = surfaceMaterialInteractionLobeSample.pdf;
  solidAnglePdf = min(surfaceMaterialInteractionSample.solidAnglePdf, float16Max);

  Ray sampledRay = rayCreateDirection(
    minimalRayInteraction, minimalSurfaceInteraction, ray,
    surfaceMaterialInteractionSample.inputDirection, penetrateSurface);

  sampledRay.spreadAngle = calculateSpreadAngleFromSolidAnglePdfLocal(sampledRay.spreadAngle, solidAnglePdf);

  // Note: A zero lobe pdf signals "no valid sample"; guard the division.
  if (surfaceMaterialInteractionLobeSample.pdf != 0.0f)
  {
    const vec3 materialSampleThroughput =
      vec3(surfaceMaterialInteractionSample.throughput / surfaceMaterialInteractionLobeSample.pdf);

    throughput = clampedMaximumPositiveMultiply(
      throughput, materialSampleThroughput, kRestirPtThroughputClampedDivisionMaximum);
  }
  else
  {
    throughput = vec3(0.0f);
  }

  return sampledRay;
}

// Evaluates the unshadowed light contribution split into diffuse and specular.
// Fork-local twin of evaluateUnshadowedLight (integrator.slangh:278-298).
void restirPtEvaluateUnshadowedLight(
  LightSample lightSample,
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  MinimalRayInteraction minimalRayInteraction,
  vec3 inputDirection,
  out vec3 diffuseLight,
  out vec3 specularLight)
{
  if (dot(inputDirection, opaqueSurfaceMaterialInteraction.shadingNormal) < 0.0f &&
      (!cb.sssArgs.enableThinOpaque || !isThinOpaqueSubsurfaceMaterial(opaqueSurfaceMaterialInteraction)))
  {
    diffuseLight = vec3(0.0f);
    specularLight = vec3(0.0f);
    return;
  }

  const SurfaceMaterialInteractionSplitWeight splitWeight = opaqueSurfaceMaterialInteractionCalcProjectedWeight(
    opaqueSurfaceMaterialInteraction, minimalRayInteraction, inputDirection);

  diffuseLight = lightSample.radiance * (splitWeight.diffuseReflectionWeight + splitWeight.diffuseTransmissionWeight);
  specularLight = lightSample.radiance * splitWeight.specularReflectionWeight;
}

// Radiance on a ray that left the scene. Ports the reference's env-map branch
// (ReSTIRPTPass/PathTracer.slang:1512) onto dxvk-remix's three-way sky, matching
// the indirect integrator's own miss handling (integrator_indirect.slangh:376-401)
// so the ReSTIR PT trace view is comparable to the ReSTIR GI image.
vec3 restirPtEvalMissRadiance(vec3 direction, u16vec2 pixelCoordinate, bool skyGatherEligible)
{
  if (cb.domeLightArgs.active)
  {
    return cb.domeLightArgs.radiance * sampleDomeLightTexture(
      LinearWrapSampler, direction, cb.domeLightArgs.textureIndex, cb.domeLightArgs.worldToLightTransform);
  }

#ifdef ATMOSPHERE_AVAILABLE
  if (cb.skyMode == 1)
  {
    // Note: non-primary call shape -- no cloud temporal smoothing, no history
    // reprojection, secondary cloud LUT. Identical to integrator_indirect.slangh:387.
    return evalSkyRadiance(direction, cb.atmosphereArgs,
                           pixelCoordinate, cb.frameIdx,
                           cb.isZUp != 0,
                           /*enableCloudTemporalSmoothing=*/ false,
                           vec2(0.0f, 0.0f),
                           uint2(0u, 0u),
                           /*isPrimaryRay=*/ false,
                           /*applySkyIndirectRadianceScale=*/ skyGatherEligible);
  }
#endif

  return cb.skyBrightness * SkyProbe.SampleLevel(direction, 0);
}

// Classifies the scatter event just sampled into the path's flags and bounce
// counters. ports ReSTIRPTPass/PathTracer.slang:353-396, with the six-lobe
// Falcor model mapped onto dxvk-remix's lobes per the plan's material table.
//
// The reconnection criteria of phases 3/5 read exactly these flags, so this is
// the single function to revisit when the Enhanced paper's scene-independent
// criteria land (plan section 4 / Out of scope).
void restirPtClassifyScatterEvent(
  inout RestirPtPathState path, uint8_t sampledLobe, float perceptualRoughness,
  uint materialType)
{
  path.clearEventFlags();

  const bool isOpaque = (materialType == surfaceMaterialTypeOpaque);

  // Transmission events: opaque alpha-cutout (opacityTransmission), opaque
  // diffuse transmission, and translucent specular transmission.
  const bool isTransmission =
    (isOpaque && (sampledLobe == opaqueLobeTypeOpacityTransmission || sampledLobe == opaqueLobeTypeDiffuseTransmission)) ||
    (!isOpaque && sampledLobe == translucentLobeTypeSpecularTransmission);

  // Delta events -- reconnection is forbidden at these
  // (ReSTIRPTPass/Shift.slang:438-442). dxvk-remix has no true delta lobe on
  // opaque materials (roughness is floored at 1e-4, brdf.slangh:35), so "delta"
  // is a classification, not a different sampling path:
  //   - every non-opaque lobe is a hardcoded dirac
  //     (translucent_surface_material_interaction.slangh:294-309 sets
  //     solidAnglePdf = 1) -- glass and ray portals
  //   - opaque opacity transmission is a dirac straight-through view with no pdf
  //   - opaque specular below the delta roughness threshold
  const bool isDelta =
    !isOpaque ||
    (sampledLobe == opaqueLobeTypeOpacityTransmission) ||
    (sampledLobe == opaqueLobeTypeSpecularReflection && perceptualRoughness < cb.restirPtDeltaRoughnessThreshold);

  // "Specular bounce" counts everything that is not a rough diffuse gather; it
  // is the reference's specularBounce flag (:378-381) and the fork's
  // firstSampledLobeIsSpecular convention rolled into one.
  const bool isSpecularBounce =
    (sampledLobe != opaqueLobeTypeDiffuseReflection) &&
    (perceptualRoughness <= cb.restirPtSpecularRoughnessThreshold);

  if (!isTransmission)
  {
    if (!isSpecularBounce)
    {
      path.incrementBounces(kRestirPtBounceTypeDiffuse);
    }
    else
    {
      path.incrementBounces(kRestirPtBounceTypeSpecular);
      path.setSpecular(true);
    }
  }
  else
  {
    path.incrementBounces(kRestirPtBounceTypeTransmission);
    path.setTransmission(true);
  }

  path.setDelta(isDelta);
  path.setSpecularBounce(isSpecularBounce);
}

// Packs a resolved hit into the identity triple a later phase reconstructs the
// reconnection vertex from. Stands in for the reference's HitInfo capture
// (ReSTIRPTPass/PathTracer.slang:834).
RestirPtHit restirPtMakeHit(RayInteraction rayInteraction)
{
  RestirPtHit hit;
  hit.surfaceIndex = rayInteraction.surfaceIndex;
  hit.primitiveIndex = rayInteraction.primitiveIndex;
  hit.barycentrics = unorm2x16ToFloat2x32(rayInteraction.barycentricCoordinates);

  return hit;
}

// Fork-local twin of evalMediumChange (integrator.slangh:182-213), duplicated
// for the same include-graph reason as the other leaf helpers. Keep in sync.
void restirPtEvalMediumChange(
  bool oldInsideMedium, bool insideMedium,
  PolymorphicSurfaceMaterialInteraction polymorphicSurfaceMaterialInteraction,
  inout uint mediumMaterialIndex)
{
  const bool enteredMedium = !oldInsideMedium && insideMedium;
  const bool exitedMedium = oldInsideMedium && !insideMedium;

  if (enteredMedium)
  {
    const TranslucentSurfaceMaterialInteraction translucentSurfaceMaterialInteraction =
      translucentSurfaceMaterialInteractionCreate(polymorphicSurfaceMaterialInteraction);

    mediumMaterialIndex = translucentSurfaceMaterialInteraction.sourceSurfaceMaterialIndex;
  }
  else if (exitedMedium)
  {
    mediumMaterialIndex = SURFACE_INDEX_INVALID;
  }
}

// ---------------------------------------------------------------------------
// Path construction
// ---------------------------------------------------------------------------

// ports ReSTIRPTPass/PathTracer.slang:185-231 (generatePath). The reference
// loads the primary hit from a V-buffer and treats it as an ordinary path
// vertex; we take it from the resolved G-buffer instead (the same
// reconstruction the ReSTIR GI reuse passes anchor on,
// RtxdiApplicationBridge.slangh:265), which means the primary vertex needs no
// ray trace and no resolve.
void restirPtGeneratePath(
  u16vec2 dstPixel, u16vec2 srcPixel, uint srcFrameIdx,
  RAB_Surface primarySurface,
  out RestirPtPathState path)
{
  // Note: no `path = (RestirPtPathState)0` -- Slang refuses an initializer list
  // for a struct carrying property accessors, so every field is written
  // explicitly below. Keep this exhaustive: an unwritten field is undefined
  // register state and would break replay determinism silently.
  path.flags = uint16_t(0);
  path._stateFlags = uint8_t(0);
  path._segmentHitDistance = 0.0f;
  path.decalEncountered = false;

  path.setActive();
  path.continuePath = true;
  path.continueResolving = true;

  path.thp = vec3(1.0f);
  path.L = vec3(0.0f);
  path.LDeltaDirect = vec3(0.0f);
  path.russianRoulettePdf = 1.0f;
  path.prevScatterPdf = 1.0f;
  path.pdf = 1.0f;
  path.length = uint16_t(0);
  path.bounceCounters = 0u;
  path.sceneLength = 0.0f;
  path.firstSegmentLength = 0.0f;
  path.hit = RestirPtHit::createInvalid();

  path.pixelCoordinate = dstPixel;
  path.srcPixel = srcPixel;
  path.srcFrameIdx = srcFrameIdx;

  path.origin = primarySurface.minimalSurfaceInteraction.position;
  path.direction = -primarySurface.minimalRayInteraction.viewDirection;
  path.normal = primarySurface.opaqueSurfaceMaterialInteraction.shadingNormal;
  path.coneRadius = primarySurface.minimalRayInteraction.coneRadius;
  path.coneSpreadAngle = cb.screenSpacePixelSpreadHalfAngle;
  path.accumulatedHitDistance = primarySurface.hitDistance;
  path.mediumMaterialIndex = SURFACE_INDEX_INVALID;
  path.insideMedium = false;

  path.portalSpace = primarySurface.portalSpace;
  path.rayMask = uint8_t(OBJECT_MASK_ALL | (primarySurface.objectMask & OBJECT_MASK_ALL_DYNAMIC));

  path.enableRandomReplay = false;
  path.randomReplayIsNEE = false;
  path.randomReplayIsEscaped = false;
  path.randomReplayLength = 0;
}

// ports ReSTIRPTPass/PathTracer.slang:233-257 (generateRandomReplayPath). Same
// initial state as a fresh path, plus the replay descriptor. The reference
// reconstructs a SampleGenerator from the stored seed at :250; here the
// equivalent step is simply carrying (srcPixel, srcFrameIdx) -- every draw is
// addressed from those.
void restirPtGenerateReplayPath(
  u16vec2 dstPixel, u16vec2 srcPixel, uint srcFrameIdx,
  RAB_Surface primarySurface,
  int randomReplayLength, uint terminalKind,
  out RestirPtPathState path)
{
  restirPtGeneratePath(dstPixel, srcPixel, srcFrameIdx, primarySurface, path);

  path.enableRandomReplay = true;
  path.randomReplayLength = randomReplayLength;
  path.randomReplayIsNEE = (terminalKind == kRestirPtTerminalNee);
  path.randomReplayIsEscaped = (terminalKind == kRestirPtTerminalEscaped);
}

// Scatter at the primary surface. ports the vertex-0 half of
// ReSTIRPTPass/PathTracer.slang:1393-1440: no NEE and no emissive here, because
// RTXDI owns the primary vertex's direct light exactly as ScreenSpaceReSTIR does
// in the reference (kDisableDirectIllumination, :1023). All this vertex does is
// pick the first indirect direction.
//
// Returns false if no valid direction could be sampled.
bool restirPtScatterAtPrimarySurface(inout RestirPtPathState path, RAB_Surface primarySurface)
{
  // The G-buffer only stores an opaque interaction (RtxdiApplicationBridge.slangh:287-288
  // is explicit about this), so wrap it back up as a polymorphic one to reach
  // the shared sampling entry point.
  PolymorphicSurfaceMaterialInteraction polymorphicSurfaceMaterialInteraction =
    polymorphicSurfaceMaterialInteractionCreateInternal(primarySurface.opaqueSurfaceMaterialInteraction);

  Ray viewRay;
  viewRay.origin = path.origin;
  viewRay.coneRadius = primarySurface.minimalRayInteraction.coneRadius;
  viewRay.spreadAngle = path.coneSpreadAngle;
  viewRay.direction = path.direction;
  viewRay.tMax = floatMax;

  // Bounce 0, lobe + direction dimensions.
  RNG randomState = restirPtRngAt(path.srcPixel, path.srcFrameIdx, 0u, kRestirPtDimLobe);

  vec3 continuationThroughput = vec3(1.0f);
  uint8_t sampledLobe = uint8_t(0u);
  float sampledLobePdf = 0.0f;
  float solidAnglePdf = 0.0f;

  const Ray sampledRay = restirPtSampleScatterDirection(
    randomState, path.insideMedium, continuationThroughput,
    viewRay, primarySurface.minimalRayInteraction, primarySurface.minimalSurfaceInteraction,
    polymorphicSurfaceMaterialInteraction,
    sampledLobe, sampledLobePdf, solidAnglePdf);

  if (solidAnglePdf <= 0.0f || all(continuationThroughput == vec3(0.0f)))
  {
    path.terminate();
    return false;
  }

  path.origin = sampledRay.origin;
  path.direction = sampledRay.direction;
  path.coneRadius = sampledRay.coneRadius;
  path.coneSpreadAngle = sampledRay.spreadAngle;
  path.pdf = solidAnglePdf;
  path.prevScatterPdf = solidAnglePdf;
  path.thp *= continuationThroughput;

  // Lobe classification. ports :313-317 and :353-381: the primary-hit
  // diffuse/specular flags feed denoiser routing in phase 2, and the
  // delta/specular event flags gate reconnection from phase 3 on. The
  // specular-vs-diffuse split uses the fork's own convention (sampled lobe is
  // not diffuse AND perceptual roughness is at or below the threshold),
  // matching integrator_direct.slangh:326-332.
  restirPtClassifyScatterEvent(
    path, sampledLobe,
    roughnessToPerceptualRoughness(primarySurface.opaqueSurfaceMaterialInteraction.isotropicRoughness),
    surfaceMaterialTypeOpaque);

  path.setDiffusePrimaryHit(sampledLobe == opaqueLobeTypeDiffuseReflection);
  path.setSpecularPrimaryHit(sampledLobe == opaqueLobeTypeSpecularReflection);

  path.normal = primarySurface.opaqueSurfaceMaterialInteraction.shadingNormal;

  return true;
}

// ---------------------------------------------------------------------------
// The resolve-loop hit callback -- handleHit + handleMiss in one function
// ---------------------------------------------------------------------------

// ports ReSTIRPTPass/PathTracer.slang:964-1470 (handleHit) and :1470-1575
// (handleMiss), reduced for phase 1 as described at the top of this file.
// Structurally this mirrors integratePathVertex (integrator_indirect.slangh:213)
// because both have to satisfy the same resolve-loop contract: call
// resolveVertex first, bail out while continueResolving is set, then act.
void restirPtHandleVertex(
  RestirPtTraceArgs traceArgs, RayHitInfo rayHitInfo, inout RestirPtPathState path)
{
  // Note: deliberately NOT setting resolveModeSeparateUnorderedApproximations
  // (no unordered particle pass in the PT kernel) nor
  // resolveModeDecalMaterialBlending (whose reservoir sampling consumes the
  // static offset-555 RNG -- see the replay-safety note at the top of this file).
  const uint8_t resolveMode =
    resolveModeEmissiveOpacityTransmissionApprox |
    (cb.enableTransmissionApproximationInIndirectRays ? resolveModeTranslucencyTransmissionApprox : uint8_t(0));

  vec3 radianceAttenuation = vec3(1.0f);
  vec3 emissiveRadiance = vec3(0.0f);
  vec3 transparencyLayerEmissive = vec3(0.0f);

  Ray ray;
  RayInteraction rayInteraction;
  Surface surface;
  SurfaceInteraction surfaceInteraction;
  PolymorphicSurfaceMaterialInteraction polymorphicSurfaceMaterialInteraction;
  bool isStochasticAlphaBlend = false;
  bool pomOpaqueSurfaceEncountered = false;
  bool isRaytracedRenderTarget = false;
  uint8_t firstRayPortal = invalidRayPortalIndex;

  surfaceInteraction.position = path.origin;
  path.segmentHitDistance = 0.0f;
  path.decalEncountered = false;

  resolveVertex<RestirPtPathState>(
    resolveMode,
    rayHitInfo, path,
    ray, rayInteraction,
    surface, surfaceInteraction,
    polymorphicSurfaceMaterialInteraction,
    radianceAttenuation, emissiveRadiance,
    transparencyLayerEmissive,
    /*decalMemory=*/ uint4(0u, 0u, 0u, 0u),
    /*decalEmissiveRadiance=*/ vec3(0.0f),
    path.coneSpreadAngle,
    isStochasticAlphaBlend, firstRayPortal,
    pomOpaqueSurfaceEncountered,
    isRaytracedRenderTarget);

  // Indirect rays carry no separate transparency layer; fold the ring emissive
  // back in exactly as the indirect integrator does (integrator_indirect.slangh:315).
  emissiveRadiance += transparencyLayerEmissive;

  const bool hasHit = rayInteractionHasHit(rayInteraction);

  if (hasHit)
  {
    path.accumulatedHitDistance += path.segmentHitDistance;
    path.sceneLength += path.segmentHitDistance;

    if (path.length == uint16_t(1))
    {
      path.firstSegmentLength = path.segmentHitDistance;
    }
  }
  else if (!path.continueResolving)
  {
    // handleMiss. ports :1493-1528: the escaped-vertex radiance, with the MIS
    // weight stubbed to 1 (the reference's evalMIS against the env-map pdf at
    // :1505-1509 needs the stored lightPdf that arrives with reservoirs in
    // phase 2).
    const vec3 skyRadiance = restirPtEvalMissRadiance(path.direction, path.pixelCoordinate, !path.isSpecularBounce());

    emissiveRadiance += skyRadiance * radianceAttenuation;

    path.sceneLength = kRestirPtInvalidPathLength;

    // ports :1527 -- direct light reachable only through a delta or
    // transmission chain cannot be sampled by the direct-lighting estimator, so
    // it has to ride along in its own channel.
    if (!path.isLightSamplable() && path.length == uint16_t(1))
    {
      path.LDeltaDirect += path.getCurrentThp() * skyRadiance * radianceAttenuation;
    }
  }

  // Accumulate resolve-loop products. Emissive takes priority over attenuation
  // so an emissive surface does not attenuate its own emission
  // (integrator_indirect.slangh:413-417).
  path.L += path.getCurrentThp() * emissiveRadiance;
  path.thp *= radianceAttenuation;

  // Medium attenuation for the segment just travelled
  // (integrator_indirect.slangh:440-463).
  if (path.mediumMaterialIndex != SURFACE_INDEX_INVALID)
  {
    const MemoryPolymorphicSurfaceMaterial memoryPolymorphicSurfaceMaterial = surfaceMaterials[path.mediumMaterialIndex];
    const TranslucentSurfaceMaterial translucentSurfaceMaterial = translucentSurfaceMaterialCreate(memoryPolymorphicSurfaceMaterial);

    const vec3 volumeTransmittance = hasHit
      ? translucentSurfaceMaterialEvalVolumeTransmittance(translucentSurfaceMaterial, rayInteraction.hitDistance)
      : translucentSurfaceMaterialEvalInfiniteVolumeTransmittance(translucentSurfaceMaterial);

    path.thp *= volumeTransmittance;
  }

  // The resolve loop wants another segment (alpha, portal, ...) -- hand control
  // back to the macro without touching path state.
  if (path.continueResolving)
  {
    return;
  }

  if (!hasHit)
  {
    path.clearHit();
    path.terminate();
    return;
  }

  path.setHit(restirPtMakeHit(rayInteraction));

  // --- Emitted radiance at the hit -----------------------------------------
  // ports :1018-1075. The MIS weight against NEE is stubbed to 1 for phase 1;
  // the reference computes it from the stored emissive-sampler pdf at
  // :1041-1060, which needs the reservoir's lightPdf field (phase 2).
  const uint materialType = polymorphicSurfaceMaterialInteractionGetTypeHelper(polymorphicSurfaceMaterialInteraction);
  const vec3 emissiveLight = polymorphicSurfaceMaterialInteractionEvalEmissiveRadiance(polymorphicSurfaceMaterialInteraction);

  if (any(emissiveLight > vec3(0.0f)))
  {
    // ports :1025 -- an emissive surface reached by BSDF sampling straight off
    // the primary vertex is the primary vertex's *direct* light, which RTXDI
    // already estimates. Suppress it unless the chain went through a
    // transmission or delta event, which RTXDI cannot express; in that case the
    // contribution rides in LDeltaDirect instead (:1074).
    const bool suppressAsDirect =
      (path.length == uint16_t(1)) && !path.isTransmission() && !path.isDelta();

    const vec3 Lr = path.getCurrentThp() * emissiveLight;

    if (!suppressAsDirect)
    {
      path.L += Lr;
    }

    if (!path.isLightSamplable() && path.length == uint16_t(1))
    {
      path.LDeltaDirect += Lr;
    }
  }

  // Only opaque surfaces carry an evaluable BSDF and can host NEE; translucent
  // and ray-portal vertices are pure delta chains in this port (see the plan's
  // known non-correspondences), so they scatter and move on.
  const bool isOpaqueMaterial = (materialType == surfaceMaterialTypeOpaque);
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction;

  if (isOpaqueMaterial)
  {
    opaqueSurfaceMaterialInteraction = opaqueSurfaceMaterialInteractionCreate(polymorphicSurfaceMaterialInteraction);

    // --- Next event estimation ---------------------------------------------
    // ports :752-794 (generateLightSample) + the NEE block at :1264-1352.
    //
    // sampleLightBasicRIS is the leaf chosen deliberately: it is the only light
    // sampler in lighting.slangh that draws exclusively from the RNG handed to
    // it. sampleLightAdvancedRIS (the integrator's default, lighting.slangh:195)
    // re-keys onto RAB_InitRandomSampler(pixelIdx, cb.frameIdx, 3) internally,
    // which is neither addressable per bounce nor replayable from a different
    // (srcPixel, srcFrame), and sampleLightNaive is reference-only. The
    // reference's skipLightSampleRandomNumbers dance (:796-817) has no analogue
    // here: this whole site re-bases at kRestirPtDimNee, so its consumption
    // count is irrelevant to replay.
    RNG neeRandomState = restirPtRngAt(path.srcPixel, path.srcFrameIdx, uint(path.length), kRestirPtDimNee);

    LightSample lightSample;
    float invSelectionPdf = 0.0f;

    const bool lightSampleValid = sampleLightBasicRIS(
      neeRandomState, surfaceInteraction, opaqueSurfaceMaterialInteraction,
      lightSample, invSelectionPdf);

    if (lightSampleValid)
    {
      lightSample.solidAnglePdf = invSelectionPdf > 0.0f ? lightSample.solidAnglePdf / invSelectionPdf : 0.0f;

      const vec3 inputDirection = normalize(lightSample.position - surfaceInteraction.position);

      vec3 diffuseLight, specularLight;
      restirPtEvaluateUnshadowedLight(
        lightSample, opaqueSurfaceMaterialInteraction, rayInteraction, inputDirection,
        diffuseLight, specularLight);

      // Shadow ray. Twin of evalNEESecondary (integrator.slangh:215-276) minus
      // the POM and ray-portal transport paths, neither of which phase 1 uses.
      uint8_t neeRayMask = uint8_t(OBJECT_MASK_OPAQUE | (path.rayMask & OBJECT_MASK_ALL_DYNAMIC));
      neeRayMask |= cb.enableIndirectTranslucentShadows ? uint8_t(OBJECT_MASK_TRANSLUCENT) : uint8_t(0);
      neeRayMask |= cb.enableIndirectAlphaBlendShadows ? uint8_t(OBJECT_MASK_ALPHA_BLEND) : uint8_t(0);

      const bool isThinOpaqueSubsurface = isThinOpaqueSubsurfaceMaterial(opaqueSurfaceMaterialInteraction);

      // Shorten the ray slightly to avoid self-intersection at the light, using
      // the same mantissa trick the integrator uses (integrator.slangh:241-249).
      const float estimatedLength = length(lightSample.position - surfaceInteraction.position);
      const uint floatOffset = 4096u;
      const float tMaxFactor = max(0.98f, asfloat(asuint(estimatedLength) - floatOffset) / estimatedLength);

      const VisibilityResult visibility = traceVisibilityRay<visibilityModeEnableTranslucentMaterials>(
        surfaceInteraction, lightSample.position, neeRayMask,
        invalidRayPortalIndex, path.portalSpace, /*pomOpaqueSurfaceEncountered=*/ false,
        rayInteraction.coneRadius, ray.spreadAngle, tMaxFactor,
        /*hasRayOriginatedFromViewModel=*/ false, /*usePreviousTLAS=*/ false,
        rayInteraction.surfaceIndex, surfaceInteraction.textureCoordinates,
        isThinOpaqueSubsurface,
        opaqueSurfaceMaterialInteraction.shadingNormal);

      if (!visibility.hasOpaqueHit && lightSample.solidAnglePdf > 0.0f)
      {
        const vec3 lightThroughput = vec3(visibility.attenuation) / lightSample.solidAnglePdf;
        const vec3 neeLight = (diffuseLight + specularLight) * lightThroughput;

        if (isValidValue(neeLight))
        {
          path.L += path.getCurrentThp() * neeLight;
        }
      }

      // ports :1362 -- record which hemispheres were sampled so the MIS weight
      // at the *next* vertex knows NEE already covered this light.
      path.setLightSampled(true, isThinOpaqueSubsurface);
    }
    else
    {
      path.setLightSampled(false, false);
    }
  }
  else
  {
    path.setLightSampled(false, false);
  }

  // --- Russian roulette ----------------------------------------------------
  // ports :919-932 (terminatePathByRussianRoulette), invoked at :1378-1388. The
  // reference burns one sample unconditionally during replay so the streams stay
  // aligned; under dimension addressing that is unnecessary -- the draw is
  // always at (length, kRestirPtDimRR) whether or not it is acted on.
  if ((cb.restirPtFlags & RESTIR_PT_FLAG_ENABLE_RUSSIAN_ROULETTE) != 0u && path.length >= uint16_t(1))
  {
    RNG rrRandomState = restirPtRngAt(path.srcPixel, path.srcFrameIdx, uint(path.length), kRestirPtDimRR);

    const float rrVal = calcBt709Luminance(path.getCurrentThp());
    const float terminateProbability = max(0.0f, 1.0f - rrVal);

    if (getNextSampleBlueNoise(rrRandomState) < terminateProbability)
    {
      path.terminate();
      return;
    }

    path.russianRoulettePdf *= 1.0f - terminateProbability;
  }

  // --- Termination matching for replay -------------------------------------
  // ports :1030 / :1370. When replaying a stored path we stop where the base
  // path stopped. In phase 1 the replay reproduces the base draw-for-draw, so
  // this is a redundant check that must agree with natural termination -- a
  // disagreement shows up as a nonzero pixel in the parity debug view, which is
  // exactly the diagnostic the harness exists to provide.
  if (path.enableRandomReplay && path.randomReplayIsNEE &&
      int(path.length) == path.randomReplayLength)
  {
    path.terminate();
    return;
  }

  // --- Scatter -------------------------------------------------------------
  // ports :1399-1440 (generateScatterRay).
  {
    RNG randomState = restirPtRngAt(path.srcPixel, path.srcFrameIdx, uint(path.length), kRestirPtDimLobe);

    vec3 continuationThroughput = vec3(1.0f);
    uint8_t sampledLobe = uint8_t(0u);
    float sampledLobePdf = 0.0f;
    float solidAnglePdf = 0.0f;

    const bool oldInsideMedium = path.insideMedium;

    const Ray sampledRay = restirPtSampleScatterDirection(
      randomState, path.insideMedium, continuationThroughput,
      ray, rayInteraction, surfaceInteraction,
      polymorphicSurfaceMaterialInteraction,
      sampledLobe, sampledLobePdf, solidAnglePdf);

    // Track medium entry/exit so the volume transmittance above stays correct
    // through glass (integrator_indirect.slangh:612-614).
    restirPtEvalMediumChange(
      oldInsideMedium, path.insideMedium, polymorphicSurfaceMaterialInteraction, path.mediumMaterialIndex);

    if (solidAnglePdf <= 0.0f || all(continuationThroughput == vec3(0.0f)))
    {
      path.terminate();
      return;
    }

    path.origin = sampledRay.origin;
    path.direction = sampledRay.direction;
    path.coneRadius = sampledRay.coneRadius;
    path.coneSpreadAngle = sampledRay.spreadAngle;
    path.pdf = solidAnglePdf;
    path.prevScatterPdf = solidAnglePdf;
    path.normal = isOpaqueMaterial
      ? opaqueSurfaceMaterialInteraction.shadingNormal
      : surfaceInteraction.geometryNormal;

    const float perceptualRoughness = isOpaqueMaterial
      ? roughnessToPerceptualRoughness(opaqueSurfaceMaterialInteraction.isotropicRoughness)
      : 0.0f;

    restirPtClassifyScatterEvent(path, sampledLobe, perceptualRoughness, materialType);

    path.thp *= continuationThroughput;
    path.continuePath = true;
  }
}

// ---------------------------------------------------------------------------
// Path drivers
// ---------------------------------------------------------------------------

// The shared body of both the trace and replay entry points. ports the loop of
// ReSTIRPTPass/TracePass.cs.slang:27-39 (tracePath) and
// ReSTIRPTPass/PathTracer.slang:1594-1613 (traceRandomReplayPath), which are the
// same loop with different initial state -- which is the whole point of the
// design: the replay exercises byte-for-byte the same code the resampling passes
// will call in later phases.
vec3 restirPtTracePathInternal(
  inout RestirPtPathState path, uint maxBounces, out uint outPathLength, out uint outTerminalKind)
{
  outTerminalKind = kRestirPtTerminalNone;
  outPathLength = 0u;

  const RestirPtTraceArgs traceArgs = RestirPtTraceArgs();

  // If we are inside a solid translucent object backface culling has to be off,
  // otherwise the far side of the object is never hit
  // (integrator_indirect.slangh:1448-1451).
  for (uint bounce = 1u; bounce <= maxBounces; ++bounce)
  {
    if (path.isTerminated())
    {
      break;
    }

    path.length = uint16_t(bounce);
    path.continuePath = false;

    Ray segmentRay;
    segmentRay.origin = path.origin;
    segmentRay.coneRadius = path.coneRadius;
    segmentRay.spreadAngle = path.coneSpreadAngle;
    segmentRay.direction = path.direction;
    segmentRay.tMax = floatMax;

    uint rayFlags = path.insideMedium ? 0u : RAY_FLAG_CULL_BACK_FACING_TRIANGLES;
    rayFlags |= RAY_FLAG_FORCE_OPAQUE;

    RESOLVE_RAY_QUERY(
      traceArgs, segmentRay, rayFlags,
      restirPtHandleVertex,
      cb.secondaryRayMaxInteractions, path,
      SEGMENT_HIT_DISTANCE_UNUSED,
      DEBUG_VIEW_DISABLED, DEBUG_VIEW_DISABLED,
      false);

    outPathLength = bounce;

    if (!path.isHit())
    {
      outTerminalKind = kRestirPtTerminalEscaped;
      break;
    }

    if (!path.continuePath)
    {
      break;
    }
  }

  return path.L;
}

// Trace entry point. Traces one indirect path from the primary G-buffer surface
// at `pixel` in frame `frameIdx`, and reports the terminal descriptor a replay
// needs to match it.
vec3 restirPtTracePath(
  u16vec2 pixel, uint frameIdx, RAB_Surface primarySurface, uint maxBounces,
  out uint outPathLength, out uint outTerminalKind)
{
  RestirPtPathState path;
  restirPtGeneratePath(pixel, pixel, frameIdx, primarySurface, path);

  outPathLength = 0u;
  outTerminalKind = kRestirPtTerminalNone;

  if (!restirPtScatterAtPrimarySurface(path, primarySurface))
  {
    return vec3(0.0f);
  }

  return restirPtTracePathInternal(path, maxBounces, outPathLength, outTerminalKind);
}

// Replay entry point. ports ReSTIRPTPass/PathTracer.slang:1578-1619
// (traceRandomReplayPath): reconstructs the path identified by
// (srcPixel, srcFrameIdx) and re-walks it.
//
// PHASE 1 SEMANTICS: this is a *full* replay -- it accumulates exactly as the
// base trace does, so the two radiances are directly comparable and any
// divergence in the random stream shows up as a nonzero difference. The
// reference's replay instead accumulates only the terminal contribution
// (:1070-1075, :1522-1528), because there it computes a shifted contribution
// rather than a whole path; that gating arrives with the hybrid shift in phase 5.
//
// dstPrimarySurface is the surface the replay anchors on. In phase 1 it is the
// same surface the base path was traced from, so parity must be bit-exact. From
// phase 3 on it will be a *neighbour's* surface, which is when this function
// starts doing real work.
vec3 restirPtTraceReplayPath(
  u16vec2 dstPixel, u16vec2 srcPixel, uint srcFrameIdx,
  RAB_Surface dstPrimarySurface, uint maxBounces,
  int randomReplayLength, uint terminalKind,
  out uint outPathLength, out uint outTerminalKind)
{
  RestirPtPathState path;
  restirPtGenerateReplayPath(
    dstPixel, srcPixel, srcFrameIdx, dstPrimarySurface, randomReplayLength, terminalKind, path);

  outPathLength = 0u;
  outTerminalKind = kRestirPtTerminalNone;

  if (!restirPtScatterAtPrimarySurface(path, dstPrimarySurface))
  {
    return vec3(0.0f);
  }

  // Termination matching: never walk past the base path's length.
  const uint replayBounces = min(maxBounces, uint(max(randomReplayLength, 0)));

  return restirPtTracePathInternal(path, replayBounces, outPathLength, outTerminalKind);
}
