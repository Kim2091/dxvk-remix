#pragma once

#include "rtx/pass/fork_restir_pt/fork_restir_pt_binding_indices.h"
#include "rtx/algorithm/fork_restir_pt/restir_pt_reservoir.slangh"

// ReSTIR PT (fork) -- final shading pass bindings.
//
// Deliberately tiny. Shading a phase-2 reservoir is `F * weight` routed by one
// stored flag bit: the primary vertex's BSDF is already folded into F by the
// trace kernel's own primary scatter, so unlike ReSTIR GI final shading
// (restir_gi_final_shading_bindings.slangh) there is no surface interaction to
// rebuild and no G-buffer set to bind.

// Inputs

layout(r16ui, binding = FORK_RESTIR_PT_FS_BINDING_SHARED_FLAGS_INPUT)
Texture2D<uint16_t> SharedFlags;

layout(r16f, binding = FORK_RESTIR_PT_FS_BINDING_PRIMARY_CONE_RADIUS_INPUT)
Texture2D<float> PrimaryConeRadius;

layout(binding = FORK_RESTIR_PT_FS_BINDING_RESERVOIR_INPUT)
RWStructuredBuffer<RestirPtReservoir> RestirPtReservoirBuffer;

// Inputs / Outputs
//
// Added to IN PLACE: integrate_nee has already written these (its NEE-cache
// first-bounce light plus the hit-T routed out of IndirectRadianceHitDistance),
// and that contribution must survive. Same shape ReSTIR GI final shading uses.

layout(rgba16f, binding = FORK_RESTIR_PT_FS_BINDING_PRIMARY_INDIRECT_DIFFUSE_INPUT_OUTPUT)
RWTexture2D<float4> PrimaryIndirectDiffuseLobeRadianceHitDistance;

layout(rgba16f, binding = FORK_RESTIR_PT_FS_BINDING_PRIMARY_INDIRECT_SPECULAR_INPUT_OUTPUT)
RWTexture2D<float4> PrimaryIndirectSpecularLobeRadianceHitDistance;
