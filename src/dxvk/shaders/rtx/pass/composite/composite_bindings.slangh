#pragma once

#include "rtx/pass/composite/composite_binding_indices.h"

#include "rtx/utility/shader_types.h"
#include "numos/lib/atmosphere_args.h"
#include "numos/lib/aerial_perspective_light.h"

// Constants

layout(binding = COMPOSITE_CONSTANTS_INPUT)
ConstantBuffer<CompositeArgs> cb;

// Inputs

layout(r16ui, binding = COMPOSITE_SHARED_FLAGS_INPUT)
RWTexture2D<uint16_t> SharedFlags;
layout(binding = COMPOSITE_SHARED_RADIANCE_RG_INPUT)
Texture2D<float2> SharedRadianceRG;
layout(binding = COMPOSITE_SHARED_RADIANCE_B_INPUT)
Texture2D<float> SharedRadianceB;
layout(binding = COMPOSITE_ATMOSPHERE_FOREGROUND_INPUT)
Texture2D<float4> AtmosphereForeground;
layout(binding = COMPOSITE_ATMOSPHERE_FOREGROUND_EMISSION_DEPTH_INPUT)
Texture2D<float> AtmosphereForegroundEmissionDepth;

// Sky provider (NUMOS) outputs, see composite_binding_indices.h. The Atmosphere* names are
// numos_host.slangh's binding contract (ATMOSPHERE_AVAILABLE): the far fog's lighting reads them.
layout(binding = COMPOSITE_SKY_ARGS)
ConstantBuffer<AtmosphereArgs> skyArgs;

layout(binding = COMPOSITE_SKY_CLOUD_RENDER_INPUT)
Texture2D<float4> SkyCloudRender;

layout(binding = COMPOSITE_SKY_CLOUD_DEPTH_INPUT)
Texture2D<float4> SkyCloudDepth;

layout(binding = COMPOSITE_SKY_AP_NEAR_SCATTER_INPUT)
Texture3D<float4> SkyApNearScatter;

layout(binding = COMPOSITE_SKY_AP_FAR_SCATTER_INPUT)
Texture3D<float4> SkyApFarScatter;

layout(binding = COMPOSITE_SKY_AP_FAR_TRANSMITTANCE_INPUT)
Texture3D<float4> SkyApFarTransmittance;

layout(binding = COMPOSITE_SKY_AP_FROXEL_AUX_INPUT)
Texture3D<float4> SkyApFroxelAux;

layout(binding = COMPOSITE_SKY_AP_LIGHTS_INPUT)
StructuredBuffer<AerialPerspectiveLight> SkyApLights;

layout(binding = COMPOSITE_SKY_AP_LIGHT_CLUSTERS_INPUT)
StructuredBuffer<uint> SkyApLightClusters;

layout(binding = COMPOSITE_SKY_AP_SAMPLER)
SamplerState SkyApSampler;

layout(binding = COMPOSITE_SKY_TRANSMITTANCE_LUT_INPUT)
Texture2D AtmosphereTransmittanceLut;

layout(binding = COMPOSITE_SKY_MULTISCATTERING_LUT_INPUT)
Texture2D AtmosphereMultiscatteringLut;

layout(binding = COMPOSITE_SKY_SKY_VIEW_LUT_INPUT)
Texture2D AtmosphereSkyViewLut;

layout(binding = COMPOSITE_SKY_SKY_VIEW_SAMPLER)
SamplerState AtmosphereSkyViewSampler;

layout(binding = COMPOSITE_SKY_CLOUD_SKY_TRANSMITTANCE_LUT_INPUT)
Texture2D<float4> AtmosphereCloudSkyTransmittanceLut;

layout(binding = COMPOSITE_SKY_CLOUD_SHADOW_MAP_INPUT)
Texture3D<float2> AtmosphereCloudShadowMap;

layout(binding = COMPOSITE_SKY_CLOUD_NOISE_SAMPLER)
SamplerState AtmosphereCloudNoise3DSampler;

layout(binding = COMPOSITE_SKY_CLOUD_SECONDARY_LUT_INPUT)
Texture2D<float4> AtmosphereCloudSecondaryLut;

#define ATMOSPHERE_AVAILABLE

layout(binding = COMPOSITE_SKY_NIGHT_SKY_STAR_CELLS_INPUT)
StructuredBuffer<uint> NightSkyStarCells;

layout(binding = COMPOSITE_SKY_NIGHT_SKY_STARS_INPUT)
StructuredBuffer<float4> NightSkyStars;

layout(binding = COMPOSITE_SKY_NIGHT_SKY_MILKY_WAY_INPUT)
StructuredBuffer<uint> NightSkyMilkyWay;

layout(binding = COMPOSITE_SKY_NIGHT_SKY_STARLIGHT_LOW_INPUT)
Texture2D<float4> NightSkyStarlightLow;

layout(binding = COMPOSITE_SKY_NIGHT_SKY_MOON_INPUT)
Texture2D<float4> NightSkyMoon;

#define NIGHT_SKY_AVAILABLE
layout(binding = COMPOSITE_SECONDARY_HIT_DISTANCE_INPUT)
Texture2D<float> SecondaryHitDistance;

layout(binding = COMPOSITE_PRIMARY_ATTENUATION_INPUT)
RWTexture2D<uint> PrimaryAttenuation;
layout(binding = COMPOSITE_PRIMARY_SPECULAR_ALBEDO_INPUT)
Texture2D<float4> PrimarySpecularAlbedo;
layout(binding = COMPOSITE_PRIMARY_LINEAR_VIEW_Z_INPUT)
Texture2D<float> PrimaryLinearViewZ;
layout(rgba16, binding = COMPOSITE_PRIMARY_VIRTUAL_WORLD_SHADING_NORMAL_INPUT)
Texture2D<float4> PrimaryVirtualWorldNormalPerceptualRoughness;

layout(binding = COMPOSITE_SECONDARY_ATTENUATION_INPUT)
RWTexture2D<uint> SecondaryAttenuation;
layout(binding = COMPOSITE_SECONDARY_ALBEDO_INPUT)
Texture2D<float4> SecondaryAlbedo;
layout(binding = COMPOSITE_SECONDARY_SPECULAR_ALBEDO_INPUT)
Texture2D<float4> SecondarySpecularAlbedo;

layout(binding = COMPOSITE_PRIMARY_DIRECT_DIFFUSE_RADIANCE_HIT_DISTANCE_INPUT)
Texture2D<float4> PrimaryDirectDiffuseRadianceHitDistance;
layout(binding = COMPOSITE_PRIMARY_DIRECT_SPECULAR_RADIANCE_HIT_DISTANCE_INPUT)
Texture2D<float4> PrimaryDirectSpecularRadianceHitDistance;
layout(binding = COMPOSITE_PRIMARY_INDIRECT_DIFFUSE_RADIANCE_HIT_DISTANCE_INPUT)
Texture2D<float4> PrimaryIndirectDiffuseRadianceHitDistance;
layout(binding = COMPOSITE_PRIMARY_INDIRECT_SPECULAR_RADIANCE_HIT_DISTANCE_INPUT)
Texture2D<float4> PrimaryIndirectSpecularRadianceHitDistance;
layout(binding = COMPOSITE_SECONDARY_COMBINED_DIFFUSE_RADIANCE_HIT_DISTANCE_INPUT)
Texture2D<float4> SecondaryCombinedDiffuseRadianceHitDistance;
layout(binding = COMPOSITE_SECONDARY_COMBINED_SPECULAR_RADIANCE_HIT_DISTANCE_INPUT)
Texture2D<float4> SecondaryCombinedSpecularRadianceHitDistance;

layout(binding = COMPOSITE_BSDF_FACTOR_INPUT)
Texture2D<float2> BSDFFactor;
layout(binding = COMPOSITE_BSDF_FACTOR2_INPUT)
Texture2D<float2> BSDFFactor2;

layout(binding = COMPOSITE_PIXEL_SAMPLING_RATE_INPUT)
Texture2D<float> SparseRenderingPixelSamplingRate;

layout(binding = COMPOSITE_VOLUME_FILTERED_RADIANCE_AGE_INPUT)
Sampler3D<float> VolumeFilteredRadianceAge;
layout(binding = COMPOSITE_VOLUME_FILTERED_RADIANCE_Y_INPUT)
Sampler3D<float4> VolumeFilteredRadianceY;
layout(binding = COMPOSITE_VOLUME_FILTERED_RADIANCE_CO_CG_INPUT)
Sampler3D<float2> VolumeFilteredRadianceCoCg;

layout(rgba32ui, binding = COMPOSITE_ALPHA_GBUFFER_INPUT)
Texture2D<uint4> AlphaBlendGBuffer;

layout(binding = COMPOSITE_BLUE_NOISE_TEXTURE)
Texture2DArray BlueNoise;

layout(binding = COMPOSITE_VALUE_NOISE_SAMPLER)
Sampler3D<float4> ValueNoiseSampler;

layout(binding = COMPOSITE_SKY_LIGHT_TEXTURE)
Sampler2D<float3> SkyLight;

layout(binding = COMPOSITE_ACTIVE_PIXEL_MASK_INPUT)
Texture2D<uint> SparseRenderingActivePixelMask;

layout(binding = COMPOSITE_ACTIVE_LOCAL_PIXEL_COORDS_INPUT)
Texture2D<uint16_t> ActiveLocalPixelCoords;

// Inputs/Outputs
layout(binding = COMPOSITE_PRIMARY_ALBEDO_INPUT_OUTPUT)
RWTexture2D<float4> PrimaryAlbedo;

layout(binding = COMPOSITE_ACCUMULATED_FINAL_OUTPUT_INPUT_OUTPUT)
RWTexture2D<float4> AccumulatedFinalOutput;

// Outputs
layout(binding = COMPOSITE_FINAL_OUTPUT)
RWTexture2D<float4> FinalOutput;
layout(binding = COMPOSITE_LAST_FINAL_OUTPUT)
RWTexture2D<float4> LastFinalOutput;
layout(binding = COMPOSITE_ALPHA_BLEND_RADIANCE_OUTPUT)
RWTexture2D<float4> AlphaBlendRadiance;

layout(binding = COMPOSITE_DEBUG_VIEW_OUTPUT)
RWTexture2D<float4> DebugView;
layout(r16f, binding = COMPOSITE_RAY_RECONSTRUCTION_HIT_DISTANCE_OUTPUT)
RWTexture2D<float> RayReconstructionHitDistanceOutput;
[[vk::binding(COMPOSITE_DLSS_NR_CONTROL_MASK_OUTPUT)]]
RWTexture2D<float4> DlssNrControlMask;
layout(r8, binding = COMPOSITE_BIAS_CURRENT_COLOR_MASK_INPUT_OUTPUT)
RWTexture2D<float> BiasCurrentColorMask;

layout(r32f, binding = COMPOSITE_PRIMARY_DEPTH_INPUT_OUTPUT)
RWTexture2D<float> PrimaryDepth;
layout(rg16f, binding = COMPOSITE_PRIMARY_SCREEN_SPACE_MOTION_VECTOR_INPUT_OUTPUT)
RWTexture2D<float2> PrimaryScreenSpaceMotionVector;
layout(r32f, binding = COMPOSITE_PRIMARY_DEPTH_DLSSRR_INPUT_OUTPUT)
RWTexture2D<float> PrimaryDepthDLSSRR;
layout(rg16f, binding = COMPOSITE_PRIMARY_SCREEN_SPACE_MOTION_VECTOR_DLSSRR_INPUT_OUTPUT)
RWTexture2D<float2> PrimaryScreenSpaceMotionVectorDLSSRR;
