/*
* Inspired by Prism by Jon (OopyDoopy / KickFister / Jon).
*
* The tone curve and its working primaries (Custom Primaries 1 and 2 below) are TheGreatHmmmmm's.
* Like Prism, it runs a per-channel curve in a desaturated working basis, so bright saturated
* colours roll off without skewing hue. Prism was created by Jon for RenoDX, with a shoulder curve
* by Musa Haji, and came to this runtime through the "halocedlaart" Halo CE (MCC) path-tracer
* ReShade addon's prism.hlsli, used with the addon author's permission.
* Prism's MIT notice, from that file:
*
*   MIT License
*
*   Copyright (c) 2026 Musa Haji
*   Copyright (c) 2026 OopyDoopy / KickFister / Jon
*
*   Permission is hereby granted, free of charge, to any person obtaining a copy
*   of this software and associated documentation files (the "Software"), to deal
*   in the Software without restriction, including without limitation the rights
*   to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
*   copies of the Software, and to permit persons to whom the Software is
*   furnished to do so, subject to the following conditions:
*
*   The above copyright notice and this permission notice shall be included in all
*   copies or substantial portions of the Software.
*
*   THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
*   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
*   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
*   AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
*   LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
*   OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
*   SOFTWARE.
*/
#pragma once

// The tone curve, shared by the apply pass and the DLSS-NR fast / inverse passes.
// A per-channel smooth Reinhard shoulder above the grade's anchor (values below pass through), in a desaturated
// primaries basis. Output peaks at `peak`: 1 for SDR, peak nits / paper white nits for HDR (1 = paper white).
// The grade before it, and the curve's anchor and shoulder, come from ToneMappingGradeArgs (tonemapping.h).
// rtx_color_grade_math.h mirrors the grade and the curve on the CPU (apply, toneCurve).
// The grade clamps the anchor below 1 and the shoulder to at most 1, which keeps the curve monotonic.

static const float3x3 customPrimaries1 = float3x3(
    0.726346493f, 0.166654825f, 0.106998682f,
    0.134236977f, 0.700138867f, 0.165624142f,
    0.072639547f, 0.060120508f, 0.867239952f);

static const float3x3 customPrimariesInverse1 = float3x3(
    1.450212359f, -0.335329264f, -0.114883065f,
    -0.253468722f, 1.510707617f, -0.257238865f,
    -0.103896290f, -0.076639965f, 1.180536270f);

static const float3x3 customPrimaries2 = float3x3(
    0.737337414f, 0.150990499f, 0.111672185f,
    0.310830779f, 0.413497919f, 0.275671278f,
    0.129649707f, 0.116560894f, 0.753789354f);

static const float3x3 customPrimariesInverse2 = float3x3(
    1.604745378f, -0.578613002f, -0.026132549f,
    -1.139794955f, 3.107331527f, -0.967536430f,
    -0.099761623f, -0.380976904f, 1.480738594f);

// `shoulder`: a larger value keeps the curve straight further above the anchor and bends it later and harder.
float reinhardPiecewiseSmooth(float x, float peak, float anchor, float shoulder)
{
    if (x <= anchor)
        return x;

    float range = peak - anchor;
    float t = (x - anchor) / range;
    float s = exp(-shoulder / (t * t));
    return anchor + range * t / (1.0 + t * s);
}

float3 reinhardPiecewiseSmooth(float3 color, float peak, float anchor, float shoulder) {
  return float3(
      reinhardPiecewiseSmooth(color.x, peak, anchor, shoulder),
      reinhardPiecewiseSmooth(color.y, peak, anchor, shoulder),
      reinhardPiecewiseSmooth(color.z, peak, anchor, shoulder));
}

// The color grade: the folded matrix, then the contrast around mid gray (0.18).
// A contrast of 1 skips the power, so a grade without contrast is its matrix alone.
float3 applyGrade(float3 color, ToneMappingGradeArgs grade) {
  const float3x3 m = float3x3(grade.row0.xyz, grade.row1.xyz, grade.row2.xyz);
  color = mul(m, color);

  const float contrast = grade.row0.w;
  if (contrast != 1.0f) {
    color = 0.18f * pow(max(color, 0.0f) / 0.18f, contrast);
  }
  return color;
}

// `primaries`: tonemapPrimaries* (rtx.tonemap.primaries), from tonemapping.h.
float3 tonemap(float3 color, float peak, uint primaries, ToneMappingGradeArgs grade) {
  color = applyGrade(color, grade);
  const float anchor = grade.row1.w;
  const float shoulder = grade.row2.w;

  if (primaries == tonemapPrimariesCustom1) {
    color = mul(customPrimaries1, color);
    color = reinhardPiecewiseSmooth(color, peak, anchor, shoulder);
    color = mul(customPrimariesInverse1, color);
  } else if (primaries == tonemapPrimariesCustom2) {
    color = mul(customPrimaries2, color);
    color = reinhardPiecewiseSmooth(color, peak, anchor, shoulder);
    color = mul(customPrimariesInverse2, color);
  } else {
    // BT.709: the curve per channel, no basis change.
    color = reinhardPiecewiseSmooth(color, peak, anchor, shoulder);
  }

  return color;
}
